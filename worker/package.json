{
  "name": "lidtrack-worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --config wrangler.prod.toml",
    "db:migrate:local": "wrangler d1 migrations apply lidtrack-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lidtrack-db --remote",
    "db:migrate:prod": "wrangler d1 migrations apply lidtrack-db --remote --config wrangler.prod.toml",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  }
}
